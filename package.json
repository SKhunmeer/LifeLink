{
  "name": "bloodlink-ai",
  "version": "1.0.0",
  "private": true,
  "description": "BloodLink AI - Real-time Smart Blood Bank & Emergency Donor Network",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm --workspace=@bloodlink/api run dev",
    "dev:web": "npm --workspace=@bloodlink/web run dev",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  }
}
