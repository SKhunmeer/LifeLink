# =================================================================
# BLOODLINK AI — ENVIRONMENT CONFIGURATION
# =================================================================

# Server & Port Configuration
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Security & Authentication
JWT_SECRET=bloodlink-secure-jwt-secret-key-production-ready-2026
SESSION_SECRET=bloodlink-session-security-key-2026

# Database Engine
# By default, BloodLink AI uses the built-in high-performance embedded SQLite database 
# (auto-seeded with realistic healthcare data, zero external dependencies required).
DATABASE_PATH=./bloodlink.db

# Optional Supabase Integration (Leave blank to use local embedded engine)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Twilio SMS / WhatsApp Service
# Leave blank to operate in MOCK SANDBOX MODE (safe for local development & demonstration)
# When blank, SMS messages are securely simulated, logged, and broadcast to the UI drawer.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Optional Web3 Trust Layer (Polygon Amoy Testnet)
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
PRIVATE_KEY=
